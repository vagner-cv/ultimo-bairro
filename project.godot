; Último Bairro — protótipo para PC em Godot 4.6.
config_version=5

[application]
config/name="Último Bairro"
config/description="Sobreviva ao primeiro dia em Vila Aurora."
config/version="0.4.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://art/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.04, 0.065, 0.065, 1)
2d/snap/snap_2d_transforms_to_pixel=false

[audio]
driver/enable_input=false

[physics]
common/physics_ticks_per_second=60
